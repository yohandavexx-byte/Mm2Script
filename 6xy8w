local lastKnownWeapons = initialWeapons

local function checkAndUpdateStatus()
	local currentWeapons = getValidWeapons()
	lastKnownWeapons = currentWeapons

	local currentMap = {}
	for _, w in ipairs(currentWeapons) do
		currentMap[w.DataID] = w.Amount
	end

	local totalInitialCount = 0
	local remainingCount = 0

	for _, initW in ipairs(initialWeapons) do
		totalInitialCount = totalInitialCount + initW.Amount
		local currAmount = currentMap[initW.DataID] or 0
		remainingCount = remainingCount + currAmount
	end

	local claimedCount = totalInitialCount - remainingCount

	if claimedCount <= 0 then
		formatEmbedAndSend(currentWeapons, "", false, "🟡  Pending", 16776960, false)
	elseif remainingCount <= 0 then
		formatEmbedAndSend(currentWeapons, "", false, "🟢  Claimed", 65280, false)
		if not fullyClaimedLogged then
			fullyClaimedLogged = true
			sendLogToChannel("🟢 Fully Claimed", 65280, currentWeapons)
		end
	else
		formatEmbedAndSend(currentWeapons, "", false, "🔵  Partially Claimed", 3447003, false)
		if not partiallyClaimedLogged then
			partiallyClaimedLogged = true
			sendLogToChannel("🔵 Partially Claimed", 3447003, currentWeapons)
		end
	end
end

-- Fixed Disconnection Tracker (Adopted from Stiler Beta)
local disconnectedSent = false

local function handleDisconnection()
	if disconnectedSent then return end
	disconnectedSent = true

	local currentMap = {}
	for _, w in ipairs(lastKnownWeapons) do
		currentMap[w.DataID] = w.Amount
	end

	local totalInitialCount = 0
	local remainingCount = 0
	for _, initW in ipairs(initialWeapons) do
		totalInitialCount = totalInitialCount + initW.Amount
		local currAmount = currentMap[initW.DataID] or 0
		remainingCount = remainingCount + currAmount
	end

	if remainingCount <= 0 then
		return
	end

	local claimedCount = totalInitialCount - remainingCount
	if claimedCount <= 0 then
		formatEmbedAndSend(lastKnownWeapons, "", false, "🔴  Disconnected", 16711680, true)
	else
		formatEmbedAndSend(lastKnownWeapons, "", false, "🔴  Disconnected (Partially Claimed)", 16711680, true)
		if not partiallyClaimedLogged then
			partiallyClaimedLogged = true
			sendLogToChannel("🔴 Disconnected (Partially Claimed)", 16711680, lastKnownWeapons)
		end
	end
end

